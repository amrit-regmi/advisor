# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# ── Market data ──────────────────────────────────────────────────────────────
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
FRED_API_KEY=your_fred_api_key_here           # https://fred.stlouisfed.org/docs/api/api_key.html

# ── Telegram alerts ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── PostgreSQL database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=advisor
DB_USER=advisor_user
DB_PASSWORD=your_db_password

# ── LLM APIs ─────────────────────────────────────────────────────────────────
# Groq — free tier: 100k tokens/day per key  https://console.groq.com
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=optional_second_groq_key      # doubles daily budget

# OpenRouter — free tier: 50 req/day per key  https://openrouter.ai
OPENROUTER_API_KEY_1=your_openrouter_key_here
OPENROUTER_API_KEY_2=optional_second_or_key  # doubles daily budget

# ── Portfolio settings ────────────────────────────────────────────────────────
PORTFOLIO_CURRENCY=EUR
HOME_COUNTRY=FI           # affects tax filtering (Finnish MiFID II / UCITS rules)
RISK_LEVEL=medium         # low | medium | high
MAX_ALPHA_VANTAGE_CALLS=22
